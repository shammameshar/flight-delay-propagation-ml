import os
import pandas as pd

CSV_PATH = "../data/raw/T_ONTIME_REPORTING.csv"

print(f"Size: {os.path.getsize(CSV_PATH)/1e6:.0f} MB")

# 1. Column names (reads only 5 rows)
sample = pd.read_csv(CSV_PATH, nrows=5, low_memory=False)
print(sample.shape[1], "columns:")
print(list(sample.columns))

# 2. Which months does this file cover? (reads ONE column only)
month_col = next((c for c in ["MONTH", "Month", "FL_DATE", "FlightDate"]
                  if c in sample.columns), None)
if month_col:
    col = pd.read_csv(CSV_PATH, usecols=[month_col])[month_col]
    if "DATE" in month_col.upper():
        col = pd.to_datetime(col).dt.month
    print("\nRows per month:")
    print(col.value_counts().sort_index())
else:
    print("\nNo month/date column found")






